#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: {{ hostname }}
    password: {{ password }}
    username: {{ username }}
    #groups:  sudo
    #lock_passwd: False 
  apt:
    mirror-selection:
      primary:
#        - uri: http://gr.archive.ubuntu.com/ubuntu/
        - uri: http://localrepo.net/ubuntu/ubuntu-mirror
      fallback: offline-install
      suites:
        - jammy
      components:
        - main
        - restricted
        - universe
        - multiverse
      trusted: true
  #packages:
  #  - openssh-server
  #  - fortune
#  storage:
#    layout:
#      name: direct
  storage:
    layout:
      name: lvm
      #sizing-policy: all
      #password: {{ password }}
      password:  {{ lukpass }} 
  locale: en_US.UTF-8
  keyboard:
    layout: us
  pkgsel:
    update-policy: none
  late-commands:
    - curtin in-target -- bash -c "rm -f /etc/apt/sources.list.d/*"
    - curtin in-target -- bash -c "touch /etc/apt/sources.list.d/local.list"
    #- curtin in-target -- bash -c 'echo "deb [trusted=yes] http://localrepo.net/ubuntu/ubuntu-mirror jammy main restricted universe multiverse" >> /etc/apt/sources.list.d/local.list'
    #- curtin in-target -- bash -c 'echo "deb [trusted=yes] http://localrepo.net/ubuntu/ubuntu-mirror jammy-security main restricted universe multiverse" >> /etc/apt/sources.list.d/local.list'
    #- curtin in-target -- bash -c 'echo "deb [trusted=yes] http://localrepo.net/ubuntu/ubuntu-mirror jammy-updates main restricted universe multiverse" >> /etc/apt/sources.list.d/local.list'
    - curtin in-target -- bash -c 'echo "deb http://archive.ubuntu.com/ubuntu/ $(lsb_release -sc) main restricted universe multiverse" >> /etc/apt/sources.list.d/local.list'

    - curtin in-target -- bash -c 'echo "deb http://archive.ubuntu.com/ubuntu/ $(lsb_release -sc)-updates main restricted universe multiverse" >> /etc/apt/sources.list.d/local.list'

    - curtin in-target -- bash -c 'echo "deb http://archive.ubuntu.com/ubuntu/ $(lsb_release -sc)-backports main restricted universe multiverse" >> /etc/apt/sources.list.d/local.list'

    - curtin in-target -- bash -c 'echo "deb http://security.ubuntu.com/ubuntu $(lsb_release -sc)-security main restricted universe multiverse" >> /etc/apt/sources.list.d/local.list'

    - curtin in-target -- bash -c 'apt update -y'
    - curtin in-target -- bash -c 'apt purge -y  openssh-client'
    {% for packet in packets %}
    - curtin in-target -- bash -c 'apt-get install -y {{ packet }}' 
    {% endfor %}
  reboot: true
