user=root
server=8.8.8.8
server=8.8.4.4


log-dhcp
log-queries
log-facility=-


interface=ens19
address=/localrepo.local/192.168.199.1

dhcp-range=192.168.199.5,192.168.199.20,24h
dhcp-option=option:router,192.168.199.1
dhcp-option=option:dns-server,192.168.199.1

dhcp-boot=pxelinux.0
dhcp-match=set:efi-x86_64,option:client-arch,7
dhcp-boot=tag:efi-x86_64,bootx64.efi
enable-tftp
tftp-root={{ tftp_root_path }}
