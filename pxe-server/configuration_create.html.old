<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Configuration</title>
    <script>
        let users = []; // Array to hold fetched users

        // Fetch the list of users from an endpoint
        async function fetchUsers() {
            try {
                const response = await fetch('/users/'); // This should point to your endpoint that returns the user list
                users = await response.json(); // Assuming your API returns a JSON array of users

                const usernameSelect = document.getElementById('username');

                // Populate the dropdown with fetched users
                users.forEach(user => {
                    const option = document.createElement('option');
                    option.value = user.username; // Set username as the value
                    option.textContent = user.username; // Display username in the dropdown
                    usernameSelect.appendChild(option);
                });
            } catch (error) {
                console.error('Error fetching users:', error);
            }
        }

        // Function to handle form submission
        async function submitForm(event) {
            event.preventDefault(); // Prevent the default form submission behavior

            const selectedUser = document.getElementById('username').value;

            if (!selectedUser) {
                alert("Please select a user.");
                return;
            }

            try {
                const response = await fetch(`/create-configuration/?username=${encodeURIComponent(selectedUser)}`, {
                    method: 'GET',
                });

                // Check if the response is OK
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }

                const data = await response.json();
                alert(data.message); // Display the response message
            } catch (error) {
                console.error('Error:', error);
                alert("An error occurred while selecting the user.");
            }
        }

        // Run the fetchUsers function when the page loads
        window.onload = fetchUsers;
    </script>
</head>
<body>
    <h2>Create Configuration</h2>
    <form id="userForm" onsubmit="submitForm(event)">
        <label for="username">Username:</label><br>
        <select id="username" name="username" required>
            <option value="" disabled selected>Select a user</option>
            <!-- Options will be populated by JavaScript -->
        </select><br><br>
        
        <button type="submit">Submit</button>
    </form>
</body>
</html>
